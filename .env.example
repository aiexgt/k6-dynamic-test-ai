PORT=4000
NODE_ENV=production

# Base de Datos Local en Docker (Entornos, Credenciales privadas, Tokens de Magento)
DATABASE_URL=postgresql://runner:runner_password@localhost:5432/flowrunner
LOCAL_DATABASE_URL=postgresql://runner:runner_password@localhost:5432/flowrunner

# Base de Datos Central Compartida (Flujos, Variantes, Categorías para todo el equipo)
# Si no se define o está vacía, usa la base de datos local unificada automáticamente.
# SHARED_DATABASE_URL=postgresql://usuario:contraseña@servidor-remoto.com:5432/flowrunner_shared
